body {
  font-family: Arial, sans-serif;
  padding: 20px;
  background-color: #f4f4f4;
  color: #333;
  text-align: center;
}

h2 {
  color: #444;
   font-family: "Dancing Script", cursive;
  font-optical-sizing: auto;
}



#text-result {
  margin-top: 20px;
  color: #007BFF;
  font-size: 20px;
}

img#logo {
  width: 100px;
  margin-bottom: 20px;
}

label{margin-right:10px}input[type=number]{padding:5px;margin:10px;width:100px}button{padding:8px 16px;background-color:#4caf50;color:#fff;border:none;cursor:pointer;font-weight:bold;margin-top:10px}button:hover{background-color:#45a049}
